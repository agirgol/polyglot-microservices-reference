<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources are declared here and inherited ones are discarded.

  Without the <clear />, restore also queries whatever feeds happen to be
  configured on the machine doing the build — a private company feed, a stale
  local folder, a mirror that is down. On a machine with a feed that needs
  credentials, restore fails with a 401 that has nothing to do with this
  repository, after several minutes of retries.

  A reference architecture that only restores on the author's laptop is not a
  reference.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
